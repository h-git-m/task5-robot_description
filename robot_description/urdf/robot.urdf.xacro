<?xml version="1.0"?>
<robot name="two_wheel_pyramid_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:include filename="$(find my_robot_description)/urdf/robot.gazebo"/>

<xacro:arg name="mesh_path" default="package://my_robot_description/meshes/"/>

  <!-- ============================================================ -->
  <!-- PYRAMID CHASSIS - 3 stacked steps, Egyptian flag color order  -->
  <!-- (Black bottom, white middle, Red top - widest to narrowest)   -->
  <!-- ============================================================ -->

  <!-- Step 1 - base / bottom step (Black) -->
  <xacro:property name="step1_length" value="0.6"/>
  <xacro:property name="step1_width" value="0.4"/>
  <xacro:property name="step1_height" value="0.15"/>
  <xacro:property name="step1_mass" value="3.0"/>

  <!-- Step 2 - middle step (WHITE) -->
  <xacro:property name="step2_length" value="0.42"/>
  <xacro:property name="step2_width" value="0.28"/>
  <xacro:property name="step2_height" value="0.12"/>
  <xacro:property name="step2_mass" value="1.5"/>

  <!-- Step 3 - top step (Red) -->
  <xacro:property name="step3_length" value="0.26"/>
  <xacro:property name="step3_width" value="0.18"/>
  <xacro:property name="step3_height" value="0.10"/>
  <xacro:property name="step3_mass" value="0.8"/>

  <!-- Colors -->
  <xacro:property name="color_red" value="0.80 0.07 0.15 1.0"/>     <!-- Egyptian flag red -->
  <xacro:property name="color_white" value="1.0 1.0 1.0 1.0"/>       <!-- Egyptian flag white -->
  <xacro:property name="color_black" value="0.05 0.05 0.05 1.0"/>    <!-- Egyptian flag black -->
  <xacro:property name="color_gold" value="0.83 0.68 0.21 1.0"/>     <!-- golden eagle accent -->
  <xacro:property name="color_wheel" value="0.55 0.35 0.12 1.0"/>    <!-- antique bronze, complements the gold -->

  <!-- Wheels -->
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <xacro:property name="wheel_y_offset" value="0.23"/>

  <!-- caster wheel -->
  <xacro:property name="caster_radius" value="0.05"/>
  <xacro:property name="caster_mass" value="0.1"/>
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>
  <!-- ============================================================ -->
  <!-- CHASSIS STEP MACRO - box link (visual/collision/inertial)     -->
  <!-- identical structure for all 3 steps, only size/mass/color     -->
  <!-- differ, so it's parameterized the same way the wheel is.      -->
  <!-- ============================================================ -->
    <xacro:macro name="chassis_step" params="name length width height mass color">
    <link name="${name}">
      <visual>
        <geometry>
          <box size="${length} ${width} ${height}"/>
        </geometry>
        <material name="${name}_material">
          <color rgba="${color}"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="${length} ${width} ${height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="${(1/12) * mass * (width*width + height*height)}" ixy="0.0" ixz="0.0"
                 iyy="${(1/12) * mass * (length*length + height*height)}" iyz="0.0"
                 izz="${(1/12) * mass * (length*length + width*width)}"/>
      </inertial>
    </link>
  </xacro:macro>
  <!-- ============== STEP 1 (base_link) - Black ============== -->
  <xacro:chassis_step name="base_link" length="${step1_length}" width="${step1_width}"
                       height="${step1_height}" mass="${step1_mass}" color="${color_black}"/>

  <!-- ============== STEP 2 (middle_step_link) - WHITE ============== -->
  <joint name="middle_step_joint" type="fixed">
    <parent link="base_link"/>
    <child link="middle_step_link"/>
    <origin xyz="0 0 ${step1_height/2 + step2_height/2}" rpy="0 0 0"/>
  </joint>

  <xacro:chassis_step name="middle_step_link" length="${step2_length}" width="${step2_width}"
                       height="${step2_height}" mass="${step2_mass}" color="${color_white}"/>

  <!-- ============== STEP 3 (top_step_link) - RED ============== -->
  <joint name="top_step_joint" type="fixed">
    <parent link="middle_step_link"/>
    <child link="top_step_link"/>
    <origin xyz="0 0 ${step2_height/2 + step3_height/2}" rpy="0 0 0"/>
  </joint>

  <xacro:chassis_step name="top_step_link" length="${step3_length}" width="${step3_width}"
                       height="${step3_height}" mass="${step3_mass}" color="${color_red}"/>
  <!-- ============================================================ -->
  <!-- CAMERA - mounted on the MIDDLE (white) step, colored GOLD     -->
  <!-- ============================================================ -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="$(arg mesh_path)zed.stl"/>
      </geometry>
      <material name="camera_gold">
        <color rgba="${color_gold}"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.03 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0"
               iyy="0.00005" iyz="0.0"
               izz="0.00005"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="middle_step_link"/>
    <child link="camera_link"/>
    <origin xyz="${step2_length/2 + 0.016} 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ============================================================ -->
  <!-- LIDAR - mounted on TOP of the top (black) step, colored GOLD  -->
  <!-- ============================================================ -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="$(arg mesh_path)lidar.STL"/>
      </geometry>
      <material name="lidar_gold">
        <color rgba="${color_gold}"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="top_step_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${step3_height/2 + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- WHEELS - 2 wheels (differential drive), antique bronze color  -->
  <!-- ============================================================ -->
  <xacro:macro name="wheel" params="prefix y_reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y_reflect * wheel_y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_bronze">
          <color rgba="${color_wheel}"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <inertia ixx="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" ixy="0.0" ixz="0.0"
                 iyy="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" iyz="0.0"
                 izz="${(1/2) * wheel_mass * (wheel_radius*wheel_radius)}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel prefix="left"  y_reflect="1"/>
  <xacro:wheel prefix="right" y_reflect="-1"/>

<joint name="caster_wheel_joint" type="fixed">
  <parent link="base_link"/>
  <child link="caster_wheel_link"/>
  <!-- rear of the chassis, centered in y, dropped so the sphere still touches the ground -->
  <origin xyz="${-step1_length/2 + caster_radius} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
</joint>

<link name="caster_wheel_link">
  <visual>
    <geometry><sphere radius="${caster_radius}"/></geometry>
    <material name="caster_red"><color rgba="1.0 0.0 0.0 1.0"/></material>
  </visual>
  <collision>
    <geometry><sphere radius="${caster_radius}"/></geometry>
  </collision>
  <inertial>
    <mass value="${caster_mass}"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia ixx="${(2/5)*caster_mass*caster_radius*caster_radius}" ixy="0.0" ixz="0.0"
             iyy="${(2/5)*caster_mass*caster_radius*caster_radius}" iyz="0.0"
             izz="${(2/5)*caster_mass*caster_radius*caster_radius}"/>
  </inertial>
</link>
</robot>
